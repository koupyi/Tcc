# ==========================================
# ENVIRONMENT VARIABLES — keycaps-ecommerce-backend
# ==========================================
# Copie este arquivo para .env e preencha com valores reais.
# Variáveis sem default são OBRIGATÓRIAS.

# ==========================================
# APP
# ==========================================
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ==========================================
# DATABASE (obrigatório)
# ==========================================
DATABASE_URL=postgresql://neondb_owner:npg_wkWl8j1TSrEy@ep-morning-pond-b4onl5kd-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# ==========================================
# JWT (obrigatório — mín. 32 caracteres)
# ==========================================
JWT_ACCESS_SECRET=change-this-to-at-least-32-characters-long-secret
JWT_REFRESH_SECRET=change-this-to-another-32-characters-long-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# REDIS (opcional em dev — graceful degradation)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# CORS
# ==========================================
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ==========================================
# UPLOAD
# ==========================================
UPLOAD_PROVIDER=local
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
LOCAL_UPLOAD_PATH=./uploads

# AWS S3 (necessário somente se UPLOAD_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=debug
LOG_DIR=./logs

# ==========================================
# ARGON2 (hash de senha)
# ==========================================
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ==========================================
# SMTP / EMAIL (necessário para password reset)
# ==========================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@keycaps.dev

# ==========================================
# APP URL (usado em links de email)
# ==========================================
APP_URL=http://localhost:8080

# ==========================================
# PAGAMENTOS (opcional — stub no MVP)
# ==========================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ==========================================
# MERCADO PAGO (Sandbox)
# ==========================================
# Obter em: https://www.mercadopago.com.br/developers/panel/app
# Access Token de teste começa com APP_USR
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxx
# MERCADOPAGO_WEBHOOK_SECRET=
